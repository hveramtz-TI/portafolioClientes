# ===========================================
# Portafolio de Clientes - Variables de Entorno
# ===========================================
# Copiar este archivo como .env y ajustar valores
# cp .env.example .env

# ============ Frontend (Next.js) ============
FRONTEND_PORT=3010
NEXT_PUBLIC_API_URL=http://localhost:8010

# ============ Backend (Laravel) ============
BACKEND_PORT=8010
APP_NAME=PortafolioClientes
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8010

# ============ PostgreSQL ============
POSTGRES_PORT=5433
POSTGRES_DB=portafolio
POSTGRES_USER=portafolio
POSTGRES_PASSWORD=secret

# ============ Redis ============
REDIS_PORT=6380

# ============ MinIO (S3-compatible) ============
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin123
MINIO_API_PORT=9010
MINIO_CONSOLE_PORT=9011
MINIO_BUCKET=portafolio

# ============ Sanctum (SPA Auth) ============
SANCTUM_STATEFUL_DOMAINS=localhost:3010,localhost:8010
SESSION_DOMAIN=.localhost
