# ===========================================
# Portafolio de Clientes - Variables de Entorno
# ===========================================
# Copiar este archivo como .env y ajustar valores
# cp .env.example .env

# ============ Frontend (Next.js) ============
FRONTEND_PORT=3000
NEXT_PUBLIC_API_URL=http://localhost:8000

# ============ Backend (Laravel) ============
BACKEND_PORT=8000
APP_NAME=PortafolioClientes
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

# ============ PostgreSQL ============
POSTGRES_PORT=5432
POSTGRES_DB=portafolio
POSTGRES_USER=portafolio
POSTGRES_PASSWORD=secret

# ============ Redis ============
REDIS_PORT=6379

# ============ MinIO (S3-compatible) ============
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin123
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_BUCKET=portafolio
